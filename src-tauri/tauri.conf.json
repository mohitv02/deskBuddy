{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskBuddy",
  "mainBinaryName": "deskbuddy",
  "version": "0.1.0",
  "identifier": "dev.deskbuddy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "Desktop buddy with todos and an encrypted vault",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "publisher": "DeskBuddy",
    "longDescription": "An always-visible animated desk buddy with a todo list (with alarms) and an encrypted, searchable vault for VMs, passwords, API keys, commands and notes. Local-only: no network access, no telemetry.",
    "linux": {
      "deb": {
        "depends": [
          "libssl3"
        ],
        "section": "utils"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "resources": {
      "../assets/axolotl_pet/mascot.json": "pets/axolotl_pet/mascot.json",
      "../assets/axolotl_pet/svg/": "pets/axolotl_pet/svg/",
      "../assets/chibi_cat_reactions/mascot.json": "pets/chibi_cat_reactions/mascot.json",
      "../assets/chibi_cat_reactions/svg/": "pets/chibi_cat_reactions/svg/",
      "../assets/chibi_ninja_pet/mascot.json": "pets/chibi_ninja_pet/mascot.json",
      "../assets/chibi_ninja_pet/svg/": "pets/chibi_ninja_pet/svg/",
      "../assets/dragon_pet_sprites/mascot.json": "pets/dragon_pet_sprites/mascot.json",
      "../assets/dragon_pet_sprites/svg/": "pets/dragon_pet_sprites/svg/",
      "../assets/ghost-pet/mascot.json": "pets/ghost-pet/mascot.json",
      "../assets/ghost-pet/svg/": "pets/ghost-pet/svg/",
      "../assets/monkey-pet/mascot.json": "pets/monkey-pet/mascot.json",
      "../assets/monkey-pet/svg/": "pets/monkey-pet/svg/",
      "../assets/ember_dragon_sprites/mascot.json": "pets/ember_dragon_sprites/mascot.json",
      "../assets/ember_dragon_sprites/svg/": "pets/ember_dragon_sprites/svg/",
      "../assets/dragon/mascot.json": "pets/dragon/mascot.json",
      "../assets/dragon/happy.svg": "pets/dragon/happy.svg",
      "../assets/dragon/fly.svg": "pets/dragon/fly.svg",
      "../assets/dragon/flame.svg": "pets/dragon/flame.svg",
      "../assets/dragon/sad.svg": "pets/dragon/sad.svg"
    }
  }
}
