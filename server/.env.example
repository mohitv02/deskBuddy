# Copy to .env and fill in. .env is gitignored; never commit it.

# mongos router of the cluster. TLS is required; point tlsCAFile at the cluster CA.
MONGODB_URI=mongodb://192.168.1.10:27017/?tls=true&tlsCAFile=/etc/ssl/mongodb/ca.pem
MONGODB_DB=deskbuddy_chat

# Where the WebSocket server listens (clients connect to ws://<this-host>:8787/ws).
CHAT_BIND=0.0.0.0:8787

# true: a client may only use the IP it connects from (stops impersonation).
# false: trust the ip the client sends (e.g. behind NAT/VPN).
CHAT_STRICT_IP=true
