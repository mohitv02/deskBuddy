# Copy to .env and fill in. .env is gitignored; never commit it.
# The server re-reads this file every few seconds: a new MONGODB_URI applies
# without a restart. DeskBuddy's Settings → Chat → "Host a chat server" can
# write MONGODB_URI and MONGODB_DB for you.

# The database. Unset: the server still runs and reports "waiting for a URI"
# on /health. With TLS, point tlsCAFile at the cluster CA on THIS machine.
MONGODB_URI=mongodb://192.168.1.10:27017/?tls=true&tlsCAFile=/etc/ssl/mongodb/ca.pem
# One database = one "home". Servers sharing it act as one cluster; a team on
# another database is reached server to server.
MONGODB_DB=deskbuddy_chat

# Where the server listens (apps connect to ws://<this-host>:8787/ws).
CHAT_BIND=0.0.0.0:8787

# How apps and other homes reach this server, comma-separated. Default:
# http://<this machine's LAN address>:<port>. Set it behind NAT or a VPN.
# CHAT_PUBLIC_URL=http://192.168.1.10:8787
